# Server (copy to server/.env)

NODE_ENV=development
HOST=0.0.0.0
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/siteflow
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin(s), comma-separated. Paths like /login are ignored.
# Preview URLs on *.vercel.app are allowed automatically.
CLIENT_ORIGIN=http://localhost:5173,https://crmanderpfront.vercel.app

# false when the UI is a separate repo/host
SERVE_CLIENT=false
